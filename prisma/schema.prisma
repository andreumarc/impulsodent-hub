generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  cif        String?
  city       String?
  email      String?
  phone      String?
  address    String?
  subscription_plan       String    @default("free")
  subscription_expires_at DateTime?
  max_clinics            Int       @default(5)
  max_users              Int       @default(20)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users      HubUser[]
  appAccess  CompanyAppAccess[]
  syncLogs   SyncLog[]
  clinics    Clinic[]

  @@map("companies")
}

model Clinic {
  id          String   @id @default(cuid())
  external_id String   // ID in the source app
  app_id      String   // 'clinicpnl', 'dentalhr', etc.
  name        String
  company_id  String
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company    Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  userAccess UserClinicAccess[]

  @@unique([app_id, external_id])
  @@map("clinics")
}

model UserClinicAccess {
  user_id    String
  clinic_id  String
  granted_at DateTime @default(now())

  user   HubUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  clinic Clinic  @relation(fields: [clinic_id], references: [id], onDelete: Cascade)

  @@id([user_id, clinic_id])
  @@map("user_clinic_access")
}

model HubUser {
  id                      String    @id @default(cuid())
  email                   String    @unique
  password_hash           String
  name                    String
  role                    String    @default("admin")
  company_id              String?
  active                  Boolean   @default(true)
  clinic_access_all       Boolean   @default(true)
  subscription_plan       String    @default("free")
  subscription_expires_at DateTime?
  max_clinics             Int       @default(5)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  company       Company?           @relation(fields: [company_id], references: [id], onDelete: SetNull)
  appRoles      UserAppRole[]
  clinicAccess  UserClinicAccess[]
  notifications Notification[]

  @@map("hub_users")
}

/// Unified notification system — sub-apps push here via /api/notifications/push.
/// Surfaced in the Hub Topbar bell for ALL profiles.
/// Kinds:
///  - app_update     → new features / breaking changes in a sub-app
///  - user_message   → DM-style: another user sent you something
///  - data_change    → data you care about was created/modified
///  - system         → maintenance windows, downtime, security
///  - info / warning → catch-all
model Notification {
  id          String   @id @default(cuid())
  user_id     String
  app_id      String?  // source app (clinicpnl/clinicvox/...) — null = Hub itself
  kind        String   @default("info") // app_update | user_message | data_change | system | info | warning
  title       String
  body        String?
  link        String?  // absolute URL or Hub-relative path users can click
  icon        String?  // optional lucide icon name
  read        Boolean  @default(false)
  created_at  DateTime @default(now())
  read_at     DateTime?

  user HubUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read, created_at])
  @@index([user_id, created_at])
  @@map("notifications")
}

model CompanyAppAccess {
  company_id String
  app_id     String
  granted_at DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@id([company_id, app_id])
  @@map("company_app_access")
}

model AppRegistration {
  id           String    @id @default(cuid())
  app_id       String    @unique
  name         String
  sync_url     String?
  api_secret   String?
  sync_enabled Boolean   @default(false)
  last_sync_at DateTime?

  @@map("app_registrations")
}

model UserAppRole {
  user_id           String
  app_id            String
  role              String
  clinic_access_all Boolean  @default(true)
  clinic_ids        String[] @default([])
  created_at        DateTime @default(now())

  user HubUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, app_id])
  @@map("user_app_roles")
}

model SyncLog {
  id             String   @id @default(cuid())
  app_id         String
  company_id     String?
  event          String
  status         String
  response_code  Int?
  error_message  String?
  created_at     DateTime @default(now())

  company Company? @relation(fields: [company_id], references: [id], onDelete: SetNull)

  @@map("sync_logs")
}
